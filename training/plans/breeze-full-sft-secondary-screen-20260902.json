{
  "schema_version": 1,
  "description": "Expanded SGD learning-rate boundary plus weight decay, clipping, and fixed-example accumulation probes",
  "defaults": {
    "optimizer": "fp32_master_sgd",
    "learning_rate": 0.0003,
    "gradient_accumulation": 4,
